@page
@model Veterinaria.Web.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="container py-4">
    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Clientes</h1>
            <p class="text-muted mb-0">Propietarios registrados.</p>
        </div>

        <a asp-page="./Nuevo" class="btn btn-primary">
            Nuevo cliente
        </a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-8">
            <input asp-for="Buscar"
                   class="form-control"
                   placeholder="Buscar por nombre, teléfono o correo" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-primary">
                Buscar
            </button>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                Limpiar
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model.Clientes)
                {
                    <tr>
                        <td>
                            @cliente.Nombre
                            @cliente.ApellidoPaterno
                            @cliente.ApellidoMaterno
                        </td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Correo</td>
                        <td>
                            <a asp-page="./Detalle"
                               asp-route-id="@cliente.IdCliente"
                               class="btn btn-sm btn-outline-primary">Ver</a>

                            <a asp-page="./Editar"
                               asp-route-id="@cliente.IdCliente"
                               class="btn btn-sm btn-outline-secondary">Editar</a>

                            <a asp-page="/Mascotas/Index"
                               asp-route-idCliente="@cliente.IdCliente"
                               class="btn btn-sm btn-outline-success">Mascotas</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>