@page
@model Veterinaria.Web.Pages.Mascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="container py-4">
    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Mascotas</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="alert alert-danger">
                    @Model.Error
                </div>
            }
            <p class="text-muted mb-0">Mascotas registradas.</p>
        </div>

        <a asp-page="./Nueva" class="btn btn-primary">
            Nueva mascota
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Especie</th>
                    <th>Raza</th>
                    <th>Sexo</th>
                    <th>Propietario</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Mascotas)
                {
                    <tr>
                        <td>@item.Mascota.Nombre</td>
                        <td>@item.Mascota.Especie</td>
                        <td>@item.Mascota.Raza</td>
                        <td>@item.Mascota.Sexo</td>
                        <td>@item.Propietario</td>
                        <td>
                            <a asp-page="./Detalle"
                               asp-route-id="@item.Mascota.IdMascota"
                               class="btn btn-sm btn-outline-primary">Ver</a>

                            <a asp-page="./Editar"
                               asp-route-id="@item.Mascota.IdMascota"
                               class="btn btn-sm btn-outline-secondary">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>